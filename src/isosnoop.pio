.pio_version 0 // only requires PIO version 0

.program isosnoop
.side_set 1

    ; One-shot mode: trigger → capture 256 bytes → wait for next trigger
    
.wrap_target
wait_for_trigger:
    wait 0 pin 0 side 1             ; Wait for GP9 LOW (frame start)
    set y, 31 side 0                ; Y = byte counter (256 bytes = 32 blocks of 8)
    
capture_block:
    ; Capture 8 bytes per iteration (compact loop)
    set x, 7 side 1                 ; X = 8 bytes per block
    
capture_byte:
    in pins, 2 side 0               ; 4 samples = 1 byte
    in pins, 2 side 1
    in pins, 2 side 0
    in pins, 2 side 1
    jmp x--, capture_byte side 0    ; Repeat for 8 bytes
    
    jmp y--, capture_block side 1   ; Repeat for 32 blocks (256 bytes total)
.wrap                               ; After 256 bytes, wrap back to wait_for_trigger


% c-sdk {
// this is a raw helper function for use by the user which sets up the GPIO output, and configures the SM to output on a particular pin

void isosnoop_pio_setup(PIO pio, uint sm, uint offset, uint rx_pin_base, uint sampling_pin) {
    // Enable pull-ups to match the normally-HIGH signals seen on scope
    gpio_set_pulls(rx_pin_base, true, false);   // Pull-up enabled, pull-down disabled
    gpio_set_pulls(rx_pin_base + 1, true, false);
    
    pio_sm_config c = isosnoop_program_get_default_config(offset);

    // Shift to right, autopush with threshold 8
    sm_config_set_in_shift(&c, false, true, 8);
    sm_config_set_in_pin_base(&c, rx_pin_base);
    sm_config_set_in_pin_count(&c, 2); // rx_pin_base and rx_pin_base+1

    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);

    // diagnostic output showing sampling points
    pio_gpio_init(pio, sampling_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, sampling_pin, 1, true);
    sm_config_set_sideset_pins(&c, sampling_pin);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}

%}

